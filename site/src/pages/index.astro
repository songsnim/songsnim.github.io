---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Distribution from '../components/Distribution.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base
  title="Songsnim"
  description="ML 엔지니어링과 시스템 운영을 다루는 기술 블로그. 수식 유도와 실무 판단 근거를 남긴다."
>
  <h1 class="lede">모델이 <em>왜</em> 그렇게 동작하는지<br />수식까지 내려가서 확인한다.</h1>
  <p class="sub">
    Machine Learning Engineer. ML 이론을 수식으로 유도하고, 운영 중에 부딪힌 문제와 그때의 판단
    근거를 기록한다.
  </p>

  <Distribution posts={posts} />

  <PostList posts={posts} />
</Base>
