---
import { render } from 'astro:content';
import Resume from '../../../../layouts/Resume.astro';
import { slug, variant, variantNames } from '../../../../lib/resume';

export const getStaticPaths = () => variantNames.map((name) => ({ params: { slug, variant: name } }));

const v = await variant(Astro.params.variant!);
const rendered = await Promise.all(v.cases.map(async (c: any) => ({ c, Content: (await render(c)).Content })));
---

<Resume title="Portfolio" description="Case studies, one per page.">
  {
    rendered.map(({ c, Content }) => (
      <article class="case">
        <h1 class="lede">{c.data.title}</h1>
        <p class="case__meta">{c.data.role} · {c.data.period}</p>
        <div class="prose"><Content /></div>
        <p class="case__stack">{c.data.stack.join(' · ')}</p>
      </article>
    ))
  }
</Resume>
