---
import Resume from '../../../layouts/Resume.astro';
import ResumeSheet from '../../../components/ResumeSheet.astro';
import { slug, variant } from '../../../lib/resume';

export const getStaticPaths = () => [{ params: { slug } }];

const v = await variant('default');
---

<Resume title="Resume" description="이력과 포트폴리오.">
  <h1 class="lede">Resume</h1>
  <ResumeSheet summary={v.summary} experience={v.experience} />

  <h2>Portfolio</h2>
  <ul class="caselist">
    {
      v.cases.map((c: any) => (
        <li>
          <a href={`/r/${slug}/${c.id}/`}>{c.data.title}</a>
          <span class="caselist__meta">{c.data.role} · {c.data.period}</span>
          <span>{c.data.summary}</span>
        </li>
      ))
    }
  </ul>
</Resume>
