---
import { getCollection, render } from 'astro:content';
import Resume from '../../../layouts/Resume.astro';
import { slug } from '../../../lib/resume';

export const getStaticPaths = async () =>
  (await getCollection('cases', ({ data }) => !data.draft)).map((c) => ({
    params: { slug, case: c.id },
    props: { entry: c },
  }));

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Resume title={entry.data.title} description={entry.data.summary}>
  <article class="case">
    <h1 class="lede">{entry.data.title}</h1>
    <p class="case__meta">{entry.data.role} · {entry.data.period}</p>
    <div class="prose"><Content /></div>
    <p class="case__stack">{entry.data.stack.join(' · ')}</p>
  </article>
</Resume>
