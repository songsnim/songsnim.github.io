---
import '../styles/global.css';
import { counter } from '../lib/analytics';

interface Props {
  title: string;
  description: string;
  ogType?: string;
}

const { title, description, ogType = 'website' } = Astro.props;
const site = 'Songsnim';
const full = title === site ? title : `${title} · ${site}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The tab slot is a fixed 16px whatever we hand it, so these are cropped to
        the character rather than to public/character.png's generous margin — the
        drawing itself then lands about a quarter larger in the same space. The
        32px copy is what the tab shows; the 512 is for high-DPI tabs and
        bookmarks. */}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/character-icon.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      })();
    </script>
    {
      counter && (
        /* Last in the head and async, so a slow or blocked counter never holds
           up the page. See lib/analytics.ts for how own visits are excluded. */
        <script data-goatcounter={counter} async src="//gc.zgo.at/count.js" />
      )
    }
  </head>
  <body>
    <div class="shell">
      <header class="runninghead">
        <a class="runninghead__name" href="/">Songsnim</a>
        <nav class="runninghead__nav">
          <a href="/">Home</a>
          <a href="/posts">Blog</a>
          <a href="/topics">Topics</a>
          <a href="https://github.com/songsnim">GitHub</a>
          <button class="themetoggle" id="theme" type="button" aria-label="테마 전환">◐</button>
        </nav>
      </header>

      <main>
        <slot />
      </main>

    </div>

    <footer class="footband">
      <div class="footband__inner">
        <span>Songsnim Tech Blog</span>
        <span class="footband__year">© {year} Songsnim</span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
